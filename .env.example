# Example environment variables for local development
# Copy this file to .env and fill in your actual values

# OpenRouter API Key (required)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model selection (optional, defaults to mistralai/mistral-small-3.2-24b-instruct:free)
# Supported models:
# - mistralai/mistral-small-3.2-24b-instruct:free
# - google/gemini-2.5-flash
# - openai/gpt-4o
# - anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=mistralai/mistral-small-3.2-24b-instruct:free

# Optional model-compatibility switches. Leave structured output enabled for
# capable models; set it to false for models such as inclusionai/ling-3.0-tiny.
OPENROUTER_USE_STRUCTURED_OUTPUT=true

# Set to true only while diagnosing empty provider responses. It writes a
# truncated raw response to logs, which may include article text.
OPENROUTER_DEBUG_RESPONSES=false

# Note: The .env file is automatically ignored by git for security
# Never commit your actual API keys to the repository
